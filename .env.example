# Distill — environment template
# Copy to .env at the repo root (or backend/.env) and fill in values.
# Never commit real API keys.

# -----------------------------------------------------------------------------
# LLM provider (used for RAG summarization)
# -----------------------------------------------------------------------------
# Options: openai (ChatGPT), gemini (Google Gemini), ollama (local)
LLM_PROVIDER=openai

# --- ChatGPT (OpenAI) ---
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (local, no cloud key) ---
# Requires: ollama pull llama3 && ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# Optional: override provider defaults (advanced)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# -----------------------------------------------------------------------------
# Storage & RAG (relative to backend/ unless absolute paths)
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_CHUNKS=12
MAX_FILE_SIZE=52428800
