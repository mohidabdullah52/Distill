# Copy to backend/.env or use the repo-root .env (both are loaded).
# See ../.env.example for the full template with ChatGPT and Gemini API keys.

LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_CHUNKS=12
MAX_FILE_SIZE=52428800
